# ---------------------------------------------------------------------------
# PitchMirror configuration. Copy to .env (next to this file) and fill in.
# The app runs WITHOUT any key (rule-based analysis). Keys unlock AI analysis.
# ---------------------------------------------------------------------------

# Which LLM to use: auto | gemini | openai | anthropic | offline
# auto = first provider below that has a key.
LLM_PROVIDER=auto

# Google Gemini (recommended: free tier, fast, sees slide images)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional server-side Whisper transcription (for Firefox/Safari, or better accuracy).
# Browser speech recognition in Chrome/Edge works without this.
# Groq (free, very fast Whisper): https://console.groq.com/keys
STT_PROVIDER=auto
GROQ_API_KEY=

# Tuning (defaults are demo-friendly)
LLM_TIMEOUT_SECONDS=20
ANALYSIS_MIN_NEW_WORDS=30
ANALYSIS_MIN_INTERVAL_S=12
AUTO_QUESTION_MIN_INTERVAL_S=40
ENRICH_SLIDES_WITH_VISION=true
MAX_UPLOAD_MB=30
MAX_SLIDES=60
SESSION_TTL_MINUTES=180
LOG_LEVEL=INFO
